# Copy to .env and fill in both secrets before starting the application.
# Generate each value with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
POSTGRES_USER=shortcuter
POSTGRES_PASSWORD=
POSTGRES_DB=shortcuter
# Docker Compose substitutes POSTGRES_PASSWORD from the line above.
DATABASE_URL=postgresql+psycopg://shortcuter:${POSTGRES_PASSWORD}@postgres:5432/shortcuter
BASE_URL=http://localhost:8000
