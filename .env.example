# Скопировать в .env и заполнить. .env в .gitignore — в репо ему не место.
# JWT_SECRET — минимум 32 случайных символа (иначе PyJWT ругается на слабый ключ).
JWT_SECRET=change-me-to-at-least-32-random-chars-xxxx
DATABASE_URL=postgresql+psycopg://shortcuter:shortcuter@postgres:5432/shortcuter
POSTGRES_USER=shortcuter
POSTGRES_PASSWORD=shortcuter
POSTGRES_DB=shortcuter
BASE_URL=http://localhost:8000
